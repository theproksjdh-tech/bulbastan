{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulbastan",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bulbastan-db",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ]
}
