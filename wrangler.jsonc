{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulbastan",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bulbastan",
      "database_id": "6d594afb-e692-42c1-a63d-4af9eacf661e"
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "",
    "DISCORD_GUILD_ID": "1492502208363761664",
    "DISCORD_CHANNEL_ID": "1492582744524460142",
    "DISCORD_ROLE_PRES": "1512871306045952162",
    "DISCORD_ROLE_ADM": "1520917082064294091"
  }
}
